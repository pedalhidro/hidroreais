# Chain: 10200 = Gnosis Chiado (testing), 100 = Gnosis
CHAIN_ID=10200
RPC_URL=https://rpc.chiadochain.net
# Pimlico bundler + paymaster (key stays on the server)
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=
# Hot key that submits EIP-3009 transfers for external-wallet users; keep its xDAI balance small
RELAYER_PRIVATE_KEY=
# Bearer token for /admin endpoints (external-wallet members, reindex)
ADMIN_TOKEN=
# The PWA's origin(s), comma-separated, e.g. https://dimdim.pedalhidrografi.co,http://localhost:5173
ALLOWED_ORIGIN=*
# Web Push (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
MAX_OPS_PER_DAY=50
MAX_RELAYS_PER_DAY=20
PORT=8787
